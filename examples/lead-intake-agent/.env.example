# Copy to .env.local and fill in real values. Never commit .env.local.
# In production, set the same names in Vercel → Project → Settings → Environment Variables.

# --- AI model (see README → "Choosing the AI model") ---
# Vercel AI Gateway key: one key for any provider's models.
# Vercel dashboard → AI Gateway → API Keys → Create key. Optional on Vercel (the
# deployment's OIDC token is used instead). Most models need paid Gateway credits.
AI_GATEWAY_API_KEY=
# "provider/model" ids from https://vercel.com/ai-gateway/models.
# Defaults: anthropic/claude-haiku-5.5 → fallback google/gemini-3.5-flash-lite
# (or, when GOOGLE_GENERATIVE_AI_API_KEY is set: google/gemini-3.6-flash → google/gemini-flash-latest).
AI_MODEL=
AI_FALLBACK_MODEL=
# Optional: call Gemini directly with a Google AI Studio key instead of the Gateway
# (used for "google/…" models; aistudio.google.com → Get API key).
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: context window used for compaction (default 200000; 1000000 for direct Gemini).
AI_CONTEXT_WINDOW_TOKENS=
# Deprecated: old name for AI_FALLBACK_MODEL (a bare Gemini model name still works).
GEMINI_FALLBACK_MODEL=
# Demo/testing only — leave empty in normal use. "primary" = primary model fails (retry → fallback);
# "all" = every model fails (the email stays in the "analyzing" state; press "re-analyze" on /leads after removing it).
SIMULATE_AI_OUTAGE=

# --- Leads database: any Postgres (Neon, Supabase, Prisma Postgres, AWS RDS, self-hosted) ---
# Use the provider's pooled URL on Vercel (Neon "-pooler" host, Supabase port 6543).
# POSTGRES_URL is read too if DATABASE_URL is empty (some integrations set that name).
# Table "leads" is created automatically on first use.
DATABASE_URL=

# --- context.dev (sender enrichment, optional) ---
# Company lookup by the sender's email. Leave empty to work from the email alone.
CONTEXT_API_KEY=

# --- Resend (inbound email + replies) ---
# Full-access key: the channel fetches inbound email content, not just sends.
RESEND_API_KEY=
# Sender for replies, e.g. leads@mail.your-domain.com (must be a verified domain).
RESEND_FROM_ADDRESS=
# Signing secret of the Resend webhook pointing at /eve/v1/resend (whsec_...).
RESEND_WEBHOOK_SECRET=
# Reply-To on outgoing replies = the receiving address, so customer replies come back
# (needed while RESEND_FROM_ADDRESS can't receive, e.g. onboarding@resend.dev).
RESEND_REPLY_TO=

# --- Customer contact form (link in the first reply email) ---
# Public URL of this app for links in emails. Empty = Vercel's production domain.
PUBLIC_APP_URL=
# Shown on the form and in the consent text (default: M Intelligence).
COMPANY_NAME=
# Link to the company's privacy policy on the form (optional; empty = no link).
PRIVACY_POLICY_URL=
# Optional separate secret for signing form links (default: the login-cookie secret).
LEAD_FORM_SECRET=

# --- Language ---
# The web UI follows the TH/EN switch (or the browser). This sets the language the AI
# writes free-text lead data in, e.g. English (default: Thai).
LEAD_DATA_LANGUAGE=

# --- Admin login for the web UI ---
ADMIN_USERNAME=
# Use a long, unique password.
ADMIN_PASSWORD=
# Optional: secret that signs login cookies and form links. Leave empty to have one
# generated on first use and stored in the database (table app_settings).
# Changing it logs everyone out and invalidates form links already sent.
ADMIN_SESSION_SECRET=
