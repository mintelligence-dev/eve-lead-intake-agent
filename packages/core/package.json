{
  "name": "@eve-lead-intake-extension/core",
  "version": "0.1.0",
  "description": "Lead intake rules without a framework: configurable lead fields, Hot/Warm/Cold scores, automated-email detection, and signed form and session tokens.",
  "keywords": ["lead", "lead-scoring", "email", "thai"],
  "license": "MIT",
  "author": "M Intelligence",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintelligence-dev/eve-lead-intake-extension.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
